library(finetune)
library(tidymodels)
library(kernlab)
library(finetune)
library(doParallel)
library(finetune)
library(tidymodels)
library(kernlab)
library(finetune)
install.packages(doParallel)
library(doParallel)
install.packages("doParallel")
library(finetune)
library(tidymodels)
library(kernlab)
library(finetune)
library(doParallel)
library(ggplot2)
data(spam)
spam <- spam %>% mutate(type = as.factor(type))
set.seed(123)
spam_split <- initial_split(spam, prop = 0.8, strata = type)
spam_train <- training(spam_split)
spam_test <- testing(spam_split)
spam_folds <- vfold_cv(spam_train, v = 5, strata = type)
spam_recipe <- recipe(type ~ ., data = spam_train) %>%
step_zv(all_predictors()) %>%
step_normalize(all_predictors())
svm_model <- svm_rbf(
cost = tune(),
rbf_sigma = tune()
) %>%
set_engine("kernlab") %>%
set_mode("classification")
svm_workflow <- workflow() %>%
add_model(svm_model) %>%
add_recipe(spam_recipe)
grid_vals <- grid_regular(
cost(range = c(-2, 2)),
rbf_sigma(range = c(-5, -1)),
levels = 5
)
n_combinations <- nrow(grid_vals)
set.seed(123)
grid_results <- tune_grid(
svm_workflow,
resamples = spam_folds,
grid = grid_vals,
metrics = metric_set(roc_auc),
control = control_grid(save_pred = TRUE)
)
library(tidymodels)
library(kernlab)
library(finetune)
library(doParallel)
library(ggplot2)
data(spam)
spam <- spam %>% mutate(type = as.factor(type))
set.seed(123)
spam_split <- initial_split(spam, prop = 0.8, strata = type)
spam_train <- training(spam_split)
spam_test <- testing(spam_split)
# Use 3-fold cross-validation for speed
spam_folds <- vfold_cv(spam_train, v = 3, strata = type)
# Preprocessing
spam_recipe <- recipe(type ~ ., data = spam_train) %>%
step_zv(all_predictors()) %>%
step_normalize(all_predictors())
svm_model <- svm_rbf(
cost = tune(),
rbf_sigma = tune()
) %>%
set_engine("kernlab") %>%
set_mode("classification")
svm_workflow <- workflow() %>%
add_model(svm_model) %>%
add_recipe(spam_recipe)
# Smaller 3x3 grid for faster computation
grid_vals <- grid_regular(
cost(range = c(-2, 2)),
rbf_sigma(range = c(-5, -1)),
levels = 3
)
# Enable parallel processing
registerDoParallel(cores = parallel::detectCores() - 1)
set.seed(123)
grid_results <- tune_grid(
svm_workflow,
resamples = spam_folds,
grid = grid_vals,
metrics = metric_set(roc_auc),
control = control_grid(save_pred = TRUE)
)
set.seed(123)
random_results <- tune_grid(
svm_workflow,
resamples = spam_folds,
grid = grid_random(cost(), rbf_sigma(), size = 9),
metrics = metric_set(roc_auc),
control = control_grid(save_pred = TRUE)
)
library(finetune)
library(tidymodels)
library(kernlab)
library(finetune)
library(doParallel)
library(ggplot2)
data(spam)
spam <- spam %>% mutate(type = as.factor(type))
set.seed(123)
spam_split <- initial_split(spam, prop = 0.8, strata = type)
spam_train <- training(spam_split)
spam_test <- testing(spam_split)
spam_folds <- vfold_cv(spam_train, v = 5, strata = type)
spam_recipe <- recipe(type ~ ., data = spam_train) %>%
step_zv(all_predictors()) %>%
step_normalize(all_predictors())
svm_model <- svm_rbf(
cost = tune(),
rbf_sigma = tune()
) %>%
set_engine("kernlab") %>%
set_mode("classification")
svm_workflow <- workflow() %>%
add_model(svm_model) %>%
add_recipe(spam_recipe)
grid_vals <- grid_regular(
cost(range = c(-2, 2)),
rbf_sigma(range = c(-5, -1)),
levels = 5
)
n_combinations <- nrow(grid_vals)
# Grid (3x3 instead of 5x5)
grid_vals <- grid_regular(
cost(range = c(-2, 2)),
rbf_sigma(range = c(-5, -1)),
levels = 3
)
# Folds to 3
spam_folds <- vfold_cv(spam_train, v = 3, strata = type)
# Enable parallel processing
library(doParallel)
registerDoParallel(cores = parallel::detectCores() - 1)
# Grid search with lighter settings
set.seed(123)
grid_results <- tune_grid(
svm_workflow,
resamples = spam_folds,
grid = grid_vals,
metrics = metric_set(roc_auc),
control = control_grid(save_pred = TRUE, verbose = TRUE)
)
