# Load necessary packages
library(DALEX)
library(mlbench)
library(randomForest)
library(rpart)
library(iml)
# Define LIME methods before loading lime
model_type.randomForest <- function(x, ...) "regression"
predict_model.randomForest <- function(x, newdata, ...) {
data.frame(Response = predict(x, newdata = newdata))
}
library(lime)
library(caret)
library(patchwork)
# Load data
data("BostonHousing")
df <- BostonHousing
set.seed(123)
# Split data
train_index <- createDataPartition(df$medv, p = 0.8, list = FALSE)
train <- df[train_index, ]
test <- df[-train_index, ]
# Linear model
lm_model <- lm(medv ~ ., data = train)
# Tree model
tree_model <- rpart(medv ~ ., data = train)
# Random Forest (ensemble)
rf_model <- randomForest(medv ~ ., data = train)
# Select one instance
instance <- test[1, ]
# Create explainers
explainer_lm <- DALEX::explain(model = lm_model, data = train[, -14], y = train$medv, label = "Linear Model")
explainer_tree <- DALEX::explain(model = tree_model, data = train[, -14], y = train$medv, label = "Decision Tree")
explainer_rf <- DALEX::explain(model = rf_model, data = train[, -14], y = train$medv, label = "Random Forest")
# CP plots
cp_lm <- predict_profile(explainer_lm, new_observation = instance)
cp_tree <- predict_profile(explainer_tree, new_observation = instance)
cp_rf <- predict_profile(explainer_rf, new_observation = instance)
# Combine CP plots using patchwork
plot(cp_lm) + plot(cp_tree) + plot(cp_rf)
predictor_rf <- Predictor$new(rf_model, data = train[, -14], y = train$medv)
ice <- FeatureEffect$new(predictor_rf, feature = "lstat", method = "ice")
plot(ice)
explainer_lime <- lime(train[, -14], rf_model)
explanation <- explain(instance[, -14], explainer_lime, n_features = 5)
plot_features(explanation)
